# Copy to .env and fill in.

# Atlas cluster used as system of record, search, and retrieval state store.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Required for high-quality hypothesis / evidence / answer generation.
# Without this key MARE falls back to a heuristic reasoner (useful for tests).
OPENAI_API_KEY=
# Final-answer model (used for synthesis when it differs from the agent model).
OPENAI_MODEL=gpt-5
# Tool-loop model. Defaults to gpt-5-mini if unset.
OPENAI_MODEL_AGENT=gpt-5-mini
OPENAI_REASONING_EFFORT=low
MARE_MAX_AGENT_TURNS=10
# Leave unset/false so the agent must discover schema from navigation nodes.
# Set true only for the informed A/B comparison.
MARE_SCHEMA_IN_PROMPT=false

# Optional: used only if Atlas Automated Embedding is unavailable on the cluster.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MARE_TENANT_ID=demo
MARE_LOG_LEVEL=INFO

# After scripts/index_generic.py, set true so POST /ask and MCP use that saved index.
# Default off: those endpoints stay on the SaaS demo.
# MARE_GENERIC_INDEX=false
# MARE_GENERIC_SAMPLE_SIZE=1000
# Require saved vectors instead of falling back to lexical search.
# MARE_GENERIC_SEMANTIC_REQUIRED=false
# Same-turn parallel reads: off, shadow (log only), or on. Default off.
# MARE_PARALLEL_TOOLS=off
# MARE_PARALLEL_TOOLS_CAP=2
# MARE_PARALLEL_TOOLS_GLOBAL=8

# Tool-loop receipts (default on). ACGC sidecar stays off unless MARE_ACGC=true.
# MARE_COMPACT=true
# MARE_ACGC=false
# ACGC_GRPC_ADDR=localhost:50051
# ACGC_TOKEN_BUDGET=8000
